{
  "name": "hscaterhub",
  "version": "1.0.0",
  "description": "HSCaterHub Web App",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync-forkable": "node scripts/forkable_scraper.js",
    "sync-emails": "node scripts/email_scraper.js",
    "extract-forkable": "FORKABLE_RAW_OUT=scratch/forkable_latest_raw.json node automations/forkable/forkable_graphql_probe.js && node automations/forkable/forkable_export.js scratch/forkable_latest_raw.json",
    "extract-forkable-projections": "node automations/forkable/forkable_schedule.js",
    "extract-clubfeast": "node automations/clubfeast/clubfeast_extract.js",
    "test:clubfeast": "node --test automations/clubfeast/clubfeast_api.test.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^16.3.1",
    "firebase": "^10.14.1",
    "firebase-admin": "^11.11.0",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.6.4",
    "nodemailer": "^8.0.5",
    "pdf.js-extract": "^0.2.1",
    "puppeteer": "^24.40.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "vite": "^5.0.0"
  }
}
